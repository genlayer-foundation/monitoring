          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "name",
              "text": "name",
              "type": "string"
            },
            {
              "selector": "network",
              "text": "network",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "status",
              "type": "string"
            },
            {
