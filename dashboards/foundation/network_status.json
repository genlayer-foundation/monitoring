          "parser": "jq-backend",
          "refId": "E",
          "root_selector": ".result | ltrimstr(\"0x\") | .[128:]\n| [ range(0; (length/64)) as $i | .[$i*64:($i+1)*64] ]\n| map(select(length==64) | {node: (\"0x\" + (.[24:64] | ascii_downcase)), onchain_active: 1})\n| map(select(.node != \"0x0000000000000000000000000000000000000000\"))",
