          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "grafanacloud-infinity"
          },
          "filters": [],
          "format": "table",
          "parser": "jq-backend",
          "refId": "V",
          "root_selector": ".validators | map({node:(.validator_address|ascii_downcase), name:(.metadata.name // \"\"), statuscode:(if .banned_until_epoch != null then 3 elif .is_active then 1 elif .is_primed_next_epoch then 2 else 0 end), sortweight:(if .is_active then 3 elif .is_primed_next_epoch then 2 elif (.banned_until_epoch != null) then 0 else 1 end), stake:((.self_stake|tonumber)/1e18), operator:(.operator_address|ascii_downcase), activeflag:(if .is_active then 1 else 0 end), rowflag:1})",
          "source": "url",
          "type": "json",
          "url": "https://internal-explorer.genlayer.com/api/v1/validators?page_size=100",
          "url_options": {
