            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum by (node) (count_over_time({job=\"genlayer-node\"} | json | __error__=\"\" | network=\"pre-clarke\" | node!=\"\" [5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "queryType": "instant",
          "range": false,
          "refId": "L"
        }
      ],
      "title": "Pre-Clarke — validators (on-chain ↔ telemetry)",
      "transformations": [
        {
          "id": "formatString",
          "options": {
            "outputFormat": "Lower Case",
            "stringField": "node"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "universalone",
            "mode": "reduceRow",
            "reduce": {
              "include": [
                "rowflag V",
                "Value",
                "Value #L"
              ],
              "reducer": "max"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "zeroU",
            "binary": {
              "left": "universalone",
              "operator": "*",
              "right": "0"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "hasm0",
            "mode": "reduceRow",
            "reduce": {
              "include": [
                "Value",
                "zeroU"
              ],
              "reducer": "sum"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "nom",
            "binary": {
              "left": "hasm0",
              "operator": "*",
              "right": "-1"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "notm",
            "binary": {
              "left": "nom",
              "operator": "+",
              "right": "1"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "mshame",
            "binary": {
              "left": "notm",
              "operator": "*",
              "right": "activeflag V"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "m2",
            "binary": {
              "left": "hasm0",
              "operator": "*",
              "right": "2"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "MetricsCode",
            "mode": "reduceRow",
            "reduce": {
              "include": [
                "m2",
                "mshame",
                "zeroU"
              ],
              "reducer": "sum"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
