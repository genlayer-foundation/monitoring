{
  "annotations": {
    "description": "{{ if $labels.validator_name }}Uptime counter reset detected — node process restarted in the last 2 minutes.\n\nhttps://genlayerfoundation.grafana.net/d/validator-overview/validator-overview?var-validator_name={{ $labels.validator_name }}&var-network={{ $labels.network }}{{ else }}Validator restart alert error — ignore this notification{{ end }}",
    "summary": "{{ if $labels.validator_name }}Validator {{ $labels.validator_name }} restarted{{ if $labels.network }} ({{ $labels.network }}){{ end }}{{ else }}Validator restart alert error — ignore this notification{{ end }}"
  },
  "condition": "Threshold",
  "data": [
    {
      "datasourceUid": "grafanacloud-prom",
      "model": {
        "expr": "resets(genlayer_node_uptime_seconds[2m])",
        "instant": true,
        "intervalMs": 1000,
        "legendFormat": "{{ validator_name }} restarts",
        "maxDataPoints": 43200,
        "range": false,
        "refId": "RestartCount"
      },
      "queryType": "instant",
      "refId": "RestartCount",
      "relativeTimeRange": {
        "from": 120,
        "to": 0
      }
    },
    {
      "datasourceUid": "__expr__",
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                0
              ],
              "type": "gt"
            }
          }
        ],
        "expression": "RestartCount",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "Threshold",
        "type": "threshold"
      },
      "queryType": "",
      "refId": "Threshold",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      }
    },
    {
      "datasourceUid": "grafanacloud-prom",
      "model": {
        "expr": "resets(genlayer_node_uptime_seconds[2m]) > 0",
        "instant": true,
        "intervalMs": 1000,
        "legendFormat": "{{ validator_name }}",
        "maxDataPoints": 43200,
        "range": false,
        "refId": "RestartedValidators"
      },
      "queryType": "instant",
      "refId": "RestartedValidators",
      "relativeTimeRange": {
        "from": 120,
        "to": 0
      }
    }
  ],
  "execErrState": "Alerting",
  "folderUID": "dfa1v9yck3ny8b",
  "for": "0s",
  "id": 15,
  "isPaused": false,
  "keep_firing_for": "0s",
  "labels": {
    "component": "validator",
    "severity": "warning"
  },
  "noDataState": "OK",
  "notification_settings": null,
  "orgID": 1,
  "record": null,
  "ruleGroup": "Node Performance Alerts",
  "title": "Validator Restart Detected",
  "uid": "afa2gxdezjyf4f"
}
