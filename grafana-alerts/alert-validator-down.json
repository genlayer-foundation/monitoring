{
  "annotations": {
    "description": "{{ if $labels.validator_name }}Was reporting metrics but stopped responding to scrape requests. Node may be down or unreachable.\n\nhttps://genlayerfoundation.grafana.net/d/validator-overview/validator-overview?var-validator_name={{ $labels.validator_name }}&var-network={{ $labels.network }}{{ else }}Validator Down alert error — ignore this notification{{ end }}",
    "summary": "{{ if $labels.validator_name }}Validator {{ $labels.validator_name }} is down{{ if $labels.network }} ({{ $labels.network }}){{ end }}{{ else }}Validator Down alert error — ignore this notification{{ end }}"
  },
  "condition": "Threshold",
  "data": [
    {
      "datasourceUid": "grafanacloud-prom",
      "model": {
        "expr": "(up{validator_name!=\"\"} == 0 and on(instance, job, validator_name) max_over_time(up{validator_name!=\"\"}[24h]) == 1) * on(validator_name) group_left(network) (max by(validator_name, network)(genlayer_node_info) * 0 + 1)",
        "instant": true,
        "intervalMs": 1000,
        "legendFormat": "{{ validator_name }}",
        "maxDataPoints": 43200,
        "range": false,
        "refId": "UpStatus"
      },
      "queryType": "instant",
      "refId": "UpStatus",
      "relativeTimeRange": {
        "from": 86400,
        "to": 0
      }
    },
    {
      "datasourceUid": "__expr__",
      "model": {
        "expression": "UpStatus",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "reducer": "last",
        "refId": "Reduce",
        "type": "reduce"
      },
      "queryType": "",
      "refId": "Reduce",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      }
    },
    {
      "datasourceUid": "__expr__",
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                1
              ],
              "type": "lt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": []
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "expression": "Reduce",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "Threshold",
        "type": "threshold"
      },
      "queryType": "",
      "refId": "Threshold",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      }
    }
  ],
  "execErrState": "Alerting",
  "folderUID": "dfa1v9yck3ny8b",
  "for": "1m",
  "id": 22,
  "isPaused": false,
  "keep_firing_for": "0s",
  "labels": {
    "component": "validator",
    "severity": "critical"
  },
  "noDataState": "OK",
  "notification_settings": null,
  "orgID": 1,
  "record": null,
  "ruleGroup": "Node Performance Alerts",
  "title": "Validator Down",
  "uid": "afa2validator-down"
}
